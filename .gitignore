# Backup local — não versionar
fusion-mw2005.*
work/official-WHEELS.json
work/modloader/
work/*.bin
work/*-geometry.json
work/v2-shelby-geometry-check.json
# Version snapshots retain their large generated binaries locally.  The tag,
# manifests and human-readable status remain versioned.
versions/*/release/**/*.BIN
versions/*/work/
scripts/__pycache__/
# Build-time C# helpers; their sources are versioned and the build recompiles them.
tools/mwgc/MakeLampFacesTwoSided.exe
tools/mwgc/ProbeLampMaterial.exe
tools/mwgc/ReplaceBodySolids.exe
tools/mwgc/ReplaceLampSolids.exe
versions/*/variants/**/*.BIN
versions/*/release/*.zip
