## ENGINE_BRAKING; multiplies maximum torque at current gear and uses it to calculate speed loss with no throttle used
## common value range is 0.70-0.90
patch	float	bin:0x12d74	0.7
patch	float	bin:0x12d78	0.8
patch	float	bin:0x12d7c	0.9

## IDLE; minimum operating speed of engine necessary to sustain its work but not enough to move drivetrain components
## common value range is 800-950
patch	float	bin:0x12d8c	800

## TORQUE; self-explanatory; field count suggest game used to support up to 15 torque values; can only use 9 now
## common value range N/A since it differs per car
patch	float	bin:0x12d38	160
patch	float	bin:0x12d3c	220
patch	float	bin:0x12d40	320
patch	float	bin:0x12d44	477
patch	float	bin:0x12d48	523
patch	float	bin:0x12d4c	473
patch	float	bin:0x12d50	409
patch	float	bin:0x12d54	364
patch	float	bin:0x12d58	341

## MAX_RPM; maximum operating speed of engine before its destruction [drag racing only]
## common value range N/A since it differs per car
patch	float	bin:0x12d84	8000

## FLYWHEEL_MASS; the higher the mass, the higher the maximum inertia moment and therefore larger amounts of kinetic energy can be stored
## common value range is 9-15
patch	float	bin:0x12d80	12

## RED_LINE; maximum safe operating speed of engine
## common value range N/A since it differs per car
patch	float	bin:0x12d88	7000

