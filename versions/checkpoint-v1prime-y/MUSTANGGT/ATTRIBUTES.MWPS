##---------------------------------------------------
## Ford Fusion Titanium AWD
## Replacement for Ford Mustang GT
## Attributes.bin patch script
##---------------------------------------------------

memfile GLOBAL\GlobalMemoryFile.bin
vpak GLOBAL\ATTRIBUTES.BIN db

##---------------------------------------------------
## Node: pvehicle/default/cars/racers/mustanggt
##---------------------------------------------------

## TurboSND[0]
patch	int32	bin:0x2f66c	0x08f716bdB

## TurboSND[1]
patch	int32	bin:0x2f67c	0x8491a9c9

## TurboSND[2]
patch	int32	bin:0x2f68c	0x2b16df5d

## VerbalType; copspeech related; code determines what cops will call your car
## PATCH LENGTH ADDRESS, NOT DATA
patch	int32	bin:0x2f620	0x08000000

## MASS; self-explanatory; mass of car expressed in kilograms
patch	float	bin:0x2f618	1350

## engineaudio[0]
patch	int32	bin:0x2f784	0x8db4a27

## engineaudio[1]
patch	int32	bin:0x2f790	0x8db4a27

## TENSOR_SCALE; seems to be overall handling speed scale balancing
## the bigger 2nd value is the slower the car will respond to steering input
## countered by increasing of 1st and 3rd value
patch	float	bin:0x2f5e0	1
patch	float	bin:0x2f5e4	2
patch	float	bin:0x2f5e8	1
patch	float	bin:0x2f5ec	0

## HandlingRating; used to set min and max handling bars length; doesn't take effect from base or end grip values but its increase is dependent
## on chassis and tires values
## values range from 37-98 for 1st set and 90-100 for 2nd set
patch	float	bin:0x2f658	55
patch	float	bin:0x2f65c	97

##---------------------------------------------------
## Node: ecar/default/racers/mustanggt
##---------------------------------------------------

## BodyDive; maximum vector-based movement of front of car body
## 1st - Degrees/G
## 2nd - Max G
## 3rd - Degrees/sec
patch	float	bin:0x3d9c8	8
patch	float	bin:0x3d9cc	1
patch	float	bin:0x3d9d0	6

## RideHeight; in-race only; visible body height
patch	float	bin:0x3da0c	-2

## TireOffsets
## in format x, y, z, w
## x axis; car front = +; car rear = -
## y axis; left side = +; right = -
## z axis; up = +; down = - note: will move WHEELS [up or down] regarding CAR BODY, during race body will be on normal level
## unlike wheels that might be BELOW ground
## w - wheel diameter scaling; default game values range between 0.31 [elise] and 0.35 [mustanggt]
## NOTE: CAR BODY height will be changed to match wheel size
## all axles have point 0 in center of line between front left and rear right wheel or between front right and rear left

## front left
patch	float	bin:0x3d920	1.425
patch	float	bin:0x3d924	0.895
patch	float	bin:0x3d928	0
patch	float	bin:0x3d92c	0.345	

## front right
patch	float	bin:0x3d930	1.425
patch	float	bin:0x3d934	-0.895
patch	float	bin:0x3d938	0
patch	float	bin:0x3d93c	0.345

## rear right
patch	float	bin:0x3d940	-1.305
patch	float	bin:0x3d944	-0.895
patch	float	bin:0x3d948	0
patch	float	bin:0x3d94c	0.345	

## rear left
patch	float	bin:0x3d950	-1.305
patch	float	bin:0x3d954	0.895
patch	float	bin:0x3d958	0
patch	float	bin:0x3d95c	0.345

## BodySquat; maximum vector-based movement of rear of car body
## 1st - Degrees/G
## 2nd - Max G
## 3rd - Degrees/sec
patch	float	bin:0x3d9bc	8
patch	float	bin:0x3d9c0	1
patch	float	bin:0x3d9c4	6

## CamberRear; angle between the vertical axis of the wheel and the vertical axis of the vehicle
## positive values for bottom of wheel being further out than top, negative for opposite effect
## common value is 0.18
patch	float	bin:0x3da08	0.2

## CamberFront; angle between the vertical axis of the wheel and the vertical axis of the vehicle
## positive values for bottom of wheel being further out than top, negative for opposite effect
## common value is 0.22
patch	float	bin:0x3da00	0.28

## FECompressions; used to adjust height of car body regarding wheels in frontend menus
## common value range is 2x0.10-2x0.20
patch	float	bin:0x3da38	0.17
patch	float	bin:0x3da3c	0.17

## TireSkidWidth; aka tire width
## common value range is 2x0.225 for front wheels and 2x0.335 for rear wheels
patch	float	bin:0x3d9ec	0.235
patch	float	bin:0x3d9f0	0.235
patch	float	bin:0x3d9f4	0.255
patch	float	bin:0x3d9f8	0.255

## WheelSpokeCount; number of spokes in rims
## common value range N/A since it differs per car
patch	int8	bin:0x3da2c	5

## ReflectionOffset
patch	float	bin:0x3da04	-0.03

## KitWheelOffsetRear; used to move wheels along axis Y when bodykits are used
## values range from 0 to 128; applies to REAR axle
patch	int8	bin:0x3da18	0
patch	int8	bin:0x3da19	0
patch	int8	bin:0x3da1a	0
patch	int8	bin:0x3da1b	0
patch	int8	bin:0x3da1c	0
patch	int8	bin:0x3da1d	0

## BodyRoll; maximum vector-based movement of entire car body towards left or right
## simply put - car body leaning sideways
## 1st - Degrees/G
## 2nd - Max G
## 3rd - Degrees/sec
patch	float	bin:0x3da40	3.5
patch	float	bin:0x3da44	1
patch	float	bin:0x3da48	4

## KitWheelOffsetFront; used to move wheels along axis Y when bodykits are used
## values range from 0 to 128; applies to FRONT axle
patch	int8	bin:0x3da28	0
patch	int8	bin:0x3da29	0
patch	int8	bin:0x3da2a	0
patch	int8	bin:0x3da2b	0
patch	int8	bin:0x3da2c	0
patch	int8	bin:0x3da2d	0

##---------------------------------------------------
## Node: brakes/default/mustanggt
##---------------------------------------------------

## BRAKES; overall braking power per axle
## common value range is 300/400-650/700; mass dependent
patch	float	bin:0x243f8	375
patch	float	bin:0x243fc	500

## EBRAKE; handbrake power; should be larger than BRAKES value by at least 10% and larger than overall car horsepower
## common value range is 400-800; mass dependent
patch	float	bin:0x24400	850

## BRAKE_LOCK; BRAKES field values multiplier and braking force distribution ratio
## common value range is 1.00 for front axle and 3.20-3.60 for rear axle
patch	float	bin:0x243f0	1
patch	float	bin:0x243f4	3.5

##---------------------------------------------------
## Node: brakes/default/mustanggt/mustanggt_top
##---------------------------------------------------

## BRAKES
patch	float	bin:0x24664	375
patch	float	bin:0x24668	500

## EBRAKE
patch	float	bin:0x2466c	850

## BRAKE_LOCK
patch	float	bin:0x2465c	1
patch	float	bin:0x24660	3.5

##---------------------------------------------------
## Node: chassis/default/mustanggt
##---------------------------------------------------

## WHEEL_BASE; distance between the centers of the front and rear wheels
## common value range N/A since it differs per car
patch	float	bin:0x8a94	2.725

## DRAG_COEFFICIENT; air resistance of object travelling in a non-vacuum environment such as air
## common value range is 0.25-0.42
patch	float	bin:0x8ab0	0.32

## SHOCK_VALVING; shock absorber oil flow restriction
## common value range is 2x15-2x24
patch	float	bin:0x8a80	17
patch	float	bin:0x8a84	17

## RIDE_HEIGHT; aka ground clearance
## common value range is 2x6-2x9
patch	float	bin:0x8a58	7.5
patch	float	bin:0x8a5c	7.5

## SHOCK_STIFFNESS; minimum pressure inside shock absorber in pounds per square inch
## common value range is 2x30-2x80; acceleration and mass-dependent
patch	float	bin:0x8a70	40
patch	float	bin:0x8a74	40

## SHOCK_BLOWOUT; maximum size by which a dampener can compress in inches; stock same as upgraded
## common value range is 5-8
patch	float	bin:0x8a98	5

## SHOCK_EXT_STIFFNESS; maximum shock absorber rebound force
## common value range is 2x40-2x80; acceleration-, downforce- and mass-dependent
patch	float	bin:0x8a68	50
patch	float	bin:0x8a6c	50

## SWAYBAR_STIFFNESS; maximum pressure inside sway bar in pounds per square inch
## common value range is 2x200-2x450; acceleration and mass dependent
patch	float	bin:0x8a88	160
patch	float	bin:0x8a8c	280

## ROLL_CENTER; vertical center of gravity [probably in inches]
## common value range is 8-10
patch	float	bin:0x8a90	9

## TRAVEL; maximum length by which a shock can be extended if car wheels don't have contact with road surface; stock commonly higher than upgraded
## common value range is 2x6-2x8; acceleration and mass dependent
patch	float	bin:0x8a50	7
patch	float	bin:0x8a54	7

## SPRING_STIFFNESS; overall coilover pressure in pounds square inch
## common value range is 2x400-2x700
patch	float	bin:0x8a78	400
patch	float	bin:0x8a7c	400

## AERO_CG; overall distribution of aerodynamic force on the car body; values between 0 and 100; 0 for max in rear, 100 for max in front
## common value range is 47-51
patch	float	bin:0x8a9c	47

## SPRING_PROGRESSION; maximum compression speed/rate for spring to achieve maximum stiffness; stock smaller than upgraded
## higher values will make springs stiffer faster so car won't shove ground on slopes but will also increase bouncing on curbs
## common value range is 2x5-2x8
patch	float	bin:0x8a48	7.5
patch	float	bin:0x8a4c	6

## TRACK_WIDTH; distance between wheel centers based on a single axle
## common value range N/A since it differs per car
patch	float	bin:0x8a60	1.608
patch	float	bin:0x8a64	1.603

## SHOCK_DIGRESSION; digressive shocks provide smoother ride at higher speeds and absorb body roll also improving cornering; smaller value for smoother ride
## common value range is 2x0.1-2x0.5
patch	float	bin:0x8a40	0.3
patch	float	bin:0x8a44	0.3

## RENDER_MOTION; dependent on ecar node settings in body roll, dive and squat; used as a multiplier of the mentioned values to calculate car body movement
## common value range is 0.50-1.00
patch	float	bin:0x8aa0	1

## AERO_COEFFICIENT; used to define car aerodynamics factor and overall downforce; value too small will make it slow and too high will push it down to
## ground too hard making it difficult to drive and car will be constantly hitting road due to excessive amount of downforce
## common value range is 0.15-0.30
patch	float	bin:0x8aa8	0.24

## FRONT_AXLE; front axle diameter in inches
## common value range is 1.2-1.5
patch	float	bin:0x8aa4	1.5

## FRONT_WEIGHT_BIAS; overall mass distribution; values from 0 to 100; 0 for max rear bias; 100 for max front bias
## common value range is 51-55
patch	float	bin:0x8aac	50

